  <!-- 빌드 성공 시 SETUP\UPDATE 폴더로 자동 복사 — 기존 LPR PC 업데이트용.
       복사 대상: 메인 EXE/설정 + 모든 의존 DLL (Evo SDK + 통신 + AForge).
       Option(K) 인식은 Python 사이드카(OptionK_server 폴더) 로 별도 배포(여기 포함 안 함).
       CameraSetting.ini 등 운영자 환경파일은 절대 포함하지 않음. -->
  <Target Name="CopyToUpdateFolder" AfterTargets="Build" Condition="'$(Configuration)'=='Release' Or '$(Configuration)'=='Debug'">
    <MakeDir Directories="$(ProjectDir)..\SETUP\UPDATE" />
    <!-- 1) 빌드 산출물 ($(OutputPath))의 EXE + 의존 DLL -->
    <ItemGroup>
      <_UpdateOutFiles Include="$(OutputPath)KyungsinLPRx64.exe" />
      <_UpdateOutFiles Include="$(OutputPath)KyungsinLPRx64.exe.config" />
      <_UpdateOutFiles Include="$(OutputPath)AForge.dll" />
      <_UpdateOutFiles Include="$(OutputPath)AForge.Video.dll" />
      <_UpdateOutFiles Include="$(OutputPath)AForge.Video.DirectShow.dll" />
      <!-- EvoCSAPI.dll(래퍼) + Evo native는 자동배포 제외: PC의 설치버전(V6/V7)에 맞게 별도 복사(동시설치 없음) -->
      <_UpdateOutFiles Include="$(OutputPath)SDKNetLib.dll" />
      <_UpdateOutFiles Include="$(OutputPath)LibSocket.dll" />
      <_UpdateOutFiles Include="$(OutputPath)SerialDevice.dll" />
      <_UpdateOutFiles Include="$(OutputPath)Util.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_UpdateOutFiles)" DestinationFolder="$(ProjectDir)..\SETUP\UPDATE\" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
    <!-- 2) dll\ 폴더의 추가 의존 (OutputPath에 자동 복사 안 되는 native + AForge.Imaging/Math) -->
    <ItemGroup>
      <_UpdateDllFiles Include="$(ProjectDir)dll\AForge.Imaging.dll" />
      <_UpdateDllFiles Include="$(ProjectDir)dll\AForge.Math.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_UpdateDllFiles)" DestinationFolder="$(ProjectDir)..\SETUP\UPDATE\" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
    <!-- 3) 중앙 배포 폴더 D:\license-plate-recognition\UPDATE\LPR 에도 복사(있을 때만) -->
    <PropertyGroup>
      <CentralUpdate>D:\license-plate-recognition\UPDATE\LPR</CentralUpdate>
    </PropertyGroup>
    <MakeDir Directories="$(CentralUpdate)" Condition="Exists('D:\license-plate-recognition\UPDATE')" />
    <Copy SourceFiles="@(_UpdateOutFiles)" DestinationFolder="$(CentralUpdate)\" SkipUnchangedFiles="true" Condition="Exists('$(CentralUpdate)') And Exists('%(FullPath)')" />
    <Copy SourceFiles="@(_UpdateDllFiles)" DestinationFolder="$(CentralUpdate)\" SkipUnchangedFiles="true" Condition="Exists('$(CentralUpdate)') And Exists('%(FullPath)')" />
    <Message Importance="high" Text="→ UPDATE 복사 완료: $(ProjectDir)..\SETUP\UPDATE\ + D:\license-plate-recognition\UPDATE\LPR (Evo 엔진 DLL은 PC 버전별 수동복사, Option(K)는 사이드카 별도)." />
  </Target>
</Project>